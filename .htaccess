Options -Indexes -MultiViews
DirectoryIndex index.php
# Local WAMP uses its configured PHP version.
RewriteEngine On

# Protect application and database files
RewriteRule ^(?:app|data|work|uploads)/ - [F,L,NC]
RewriteRule ^(?:\.env|composer\.(?:json|lock)|README\.md|database\.sql)$ - [F,L,NC]
RewriteRule ^property(?:/|$) - [F,L,NC]

# SEO-friendly routes
RewriteRule ^homes/([a-z0-9-]+)/?$ property.php?slug=$1 [QSA,L,NC]
RewriteRule ^journal/([a-z0-9-]+)/?$ article.php?slug=$1 [QSA,L,NC]
RewriteRule ^properties/([a-z0-9-]+)/?$ properties.php?region=$1 [QSA,L,NC]
RewriteRule ^properties/?$ properties.php [QSA,L]
RewriteRule ^journal/?$ journal.php [QSA,L]
RewriteRule ^about/?$ about.php [QSA,L]
RewriteRule ^contact/?$ contact.php [QSA,L]
RewriteRule ^privacy/?$ privacy.php [QSA,L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
